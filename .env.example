# ---- TecRural: variables de entorno ----
# Copia este archivo a `.env.local` (local) o define las variables en el VPS.

# Base de datos de contactos. PostgreSQL gestionado en **Neon** (producción).
# Si no se define, la app usa SQLite local (data/tecrural.db) como respaldo.
# Se crea gratis en https://console.neon.tech
# Ejemplo: postgresql://user:pass@host/neondb?sslmode=require
DATABASE_URL=

# Número de WhatsApp en formato internacional, sin "+", espacios ni guiones.
# Ejemplo: 34600123456 (España, +34 600 123 456)
WHATSAPP_NUMBER=34600123456

# Nombre del negocio (se muestra en la marca y en los mensajes de WhatsApp)
BUSINESS_NAME=TecRural

# Contraseña para acceder al panel de administración (/admin)
# Usa una contraseña larga y única. Cámbiala antes de desplegar.
ADMIN_PASSWORD=cambia-esta-clave

# URL pública de la app (se usa para metadatos y manifest PWA)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de la API meteorológica. Open-Meteo no requiere API key.
# Si quieres usar otra API, deja esta variable apuntando a su endpoint
# compatible o modifica src/lib/weather.ts.
WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast

# API key de AEMET (opcional, recomendada): predicción oficial por municipio
# para hoy y condiciones actuales. Sin ella o si falla, la app usa Open-Meteo
# y, como último recurso, datos orientativos.
# Se obtiene gratis en https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=
